    {
      "para_index": 46,
      "text": "3) \u0e2a\u0e30\u0e2a\u0e21\u0e04\u0e38\u0e13\u0e25\u0e31\u0e01\u0e29\u0e13\u0e30\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14 30 \u0e40\u0e1f\u0e23\u0e21\u0e43\u0e19 motion_frames \u0e41\u0e25\u0e30\u0e40\u0e23\u0e35\u0e22\u0e07\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e27\u0e01\u0e40\u0e15\u0e2d\u0e23\u0e4c 5,130 \u0e04\u0e48\u0e32",
      "style": "Normal"
