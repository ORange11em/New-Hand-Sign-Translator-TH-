    {
      "para_index": 49,
      "text": "6) \u0e25\u0e49\u0e32\u0e07\u0e04\u0e34\u0e27\u0e41\u0e25\u0e30\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e44\u0e21\u0e48\u0e1e\u0e1a\u0e21\u0e37\u0e2d\u0e19\u0e32\u0e19\u0e01\u0e27\u0e48\u0e32 0.4 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35 \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e25\u0e14\u0e01\u0e32\u0e23\u0e04\u0e49\u0e32\u0e07\u0e02\u0e2d\u0e07\u0e04\u0e33\u0e17\u0e33\u0e19\u0e32\u0e22\u0e40\u0e14\u0e34\u0e21",
      "style": "Normal"
